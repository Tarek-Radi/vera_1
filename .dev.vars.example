NEXT_PUBLIC_CHECKOUT_MODE=whatsapp
# Set database and rebuild to restore stored orders/coupons/admin.
# Copy to .dev.vars for LOCAL workerd preview only. Never commit real credentials.
# Use an isolated staging/test database; preview checkout writes real records.
DATABASE_URL=""
DATABASE_SSL="require"
COUPON_HMAC_SECRET=""
# Use the exact browser origin during local preview (Next may normalize forwarded ports).
SITE_URL="http://127.0.0.1:8787"
# Keep public values in wrangler.jsonc vars consistent with the Cloudflare build.
# Supabase URL and publishable/anon key go there; never a service-role key.
