NEXT_PUBLIC_CHECKOUT_MODE=whatsapp
# Set database and rebuild to restore stored orders/coupons/admin.
# Public canonical origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional runtime origin override (Workers preview/proxy). Production: same as above.
SITE_URL=http://localhost:3000
# Supabase Project Settings > API. Publishable/anon key is safe to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Connect > transaction pooler URI. Private server-only credential.
DATABASE_URL=
# require for Supabase; disable ONLY for an isolated local test database
DATABASE_SSL=require
# Generate once using a cryptographic random generator; keep stable after importing coupons.
COUPON_HMAC_SECRET=
# Used only by integration tests; must point to a disposable vera_test database
TEST_DATABASE_URL=

# Custom artwork uploads: server-only. No Turnstile or database keys required.
ARTWORK_SCRIPT_URL=
ARTWORK_SCRIPT_SECRET=
# Match the Apps Script property; default 1 MiB per file (maximum 2 MiB).
ARTWORK_MAX_BYTES=1048576
