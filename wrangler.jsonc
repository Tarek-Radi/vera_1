{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-with-confirmed-existing-worker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "replace-with-confirmed-existing-worker",
    },
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "VERA_RUNTIME": "cloudflare",
    "NEXT_PUBLIC_CHECKOUT_MODE": "whatsapp",
    "DATABASE_SSL": "require",
    "SITE_URL": "http://127.0.0.1:8787",
    "NEXT_PUBLIC_SITE_URL": "http://127.0.0.1:8787",
    "NEXT_PUBLIC_SUPABASE_URL": "",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "",
  },
}
